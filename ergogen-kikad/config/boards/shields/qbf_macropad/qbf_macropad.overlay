#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    default_transform: matrix_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <10>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
               RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "QBF 10-key";
        transform = <&default_transform>;
        kscan = <&kscan0>;
    };
};

&xiao_i2c { status = "disabled"; };

&pinctrl {
    qbf_display_default: qbf_display_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
        };
    };
    qbf_display_sleep: qbf_display_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };
};

&xiao_spi {
    status = "okay";
    pinctrl-0 = <&qbf_display_default>;
    pinctrl-1 = <&qbf_display_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
    display0: display@0 {
        compatible = "qbf,lpm009m360a";
        reg = <0>;
        spi-max-frequency = <500000>;
        width = <144>;
        height = <72>;
        disp-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
        extcomin-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
    };
};

/ {
    chosen {
        zephyr,display = &display0;
    };
};
